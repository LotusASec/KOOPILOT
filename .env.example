# Google AI Studio'dan ücretsiz key al: https://aistudio.google.com/app/apikey
# Bu dosyayı .env olarak kopyala ve key'ini yapıştır.
# .env zaten .gitignore'da, repo'ya pushlanmaz.

GEMINI_API_KEY=

# Boş bırakırsan otomatik olarak kullanılabilir en iyi modeli seçer.
# Belirli bir model istersen: gemini-2.5-flash, gemini-2.0-flash, vb.
GEMINI_MODEL=
